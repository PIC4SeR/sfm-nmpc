<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sfm_nmpc</name>
  <version>0.4.7</version>
  <description>Social MPC Controller</description>
  <author email="noeperez@upo.es">Noé Pérez</author>
  <author email="fcaballero@us.es">Fernando Caballero</author>
  <author email="andrea.ostuni@polito.it">Andrea Ostuni</author>
  <author email="stefano.trepella@polito.it">Stefano Trepella</author>
  <author email="mauro.martini@polito.it">Mauro Martini</author>
  <maintainer email="stefano.trepella@polito.it">Stefano Trepella</maintainer>
  <license>GNU General Public License 3.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>nav2_common</depend>
  <depend>nav2_core</depend>
  <depend>nav2_util</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>angles</depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>people_msgs</depend>
  <depend>obstacle_distance_msgs</depend>
  <depend>obstacle_distance</depend>
  <depend>nav2_msgs</depend>
  <depend>pluginlib</depend>
  <depend>tf2</depend>
  <depend>libceres-dev</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_clang_format</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_core plugin="${prefix}/sfm_nmpc.xml" />
  </export>

</package>
